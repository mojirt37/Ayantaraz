  },
  "devDependencies": {
    "@eslint/js": "9.36.0",
    "@playwright/test": "1.55.0",
    "@types/node": "24.5.2",
    "@types/react": "19.2.2",
    "@types/react-dom": "19.2.2",
    "eslint": "9.36.0",
    "eslint-config-next": "16.0.0",
    "globals": "16.4.0",
    "prettier": "3.6.2",
    "typescript": "5.9.3",
    "typescript-eslint": "8.44.1",
    "vitest": "3.2.4"
  }
