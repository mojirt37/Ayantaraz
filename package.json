{
  "name": "ayan-taraz",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=24.0.0 <25"
  },
  "scripts": {
    "dev": "next dev",
    "build": "if git rev-parse --is-inside-work-tree >/dev/null 2>&1; then if [ -n \"$(git status --porcelain)\" ]; then echo 'Refusing to build a release artifact from a dirty source revision.' >&2; exit 1; fi; BUILD_ID=${BUILD_ID:-$(git rev-parse --verify HEAD)}; fi; : \"${BUILD_ID:?Set BUILD_ID to the immutable source revision}\"; BUILD_ID=\"$BUILD_ID\" next build",
    "start": "next start",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:db": "bash scripts/verify-postgres-foundation.sh",
    "test:redis": "bash scripts/verify-redis.sh",
    "db:migrate": "drizzle-kit migrate",
    "db:generate": "drizzle-kit generate",
    "sbom:production": "mkdir -p verification && npm sbom --omit=dev --sbom-format cyclonedx > verification/sbom.production.cdx.json",
    "evidence:release": "bash scripts/create-release-evidence.sh",
    "format:check": "prettier --check .",
    "format": "prettier --write .",
    "audit:production": "npm audit --omit=dev --audit-level=high"
  },
  "dependencies": {
    "better-auth": "^1.7.2",
    "drizzle-orm": "^0.45.2",
    "ioredis": "^6.0.0",
    "next": "16.0.0",
    "pg": "^8.23.0",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "server-only": "0.0.1",
    "zod": "4.1.12"
  },
  "devDependencies": {
    "@eslint/js": "9.36.0",
    "@playwright/test": "1.55.0",
    "@types/ioredis": "^4.28.10",
    "@types/node": "24.5.2",
    "@types/pg": "^8.23.1",
    "@types/react": "19.2.2",
    "@types/react-dom": "19.2.2",
    "drizzle-kit": "^0.31.10",
    "eslint": "9.36.0",
    "eslint-config-next": "16.0.0",
    "globals": "16.4.0",
    "prettier": "3.6.2",
    "typescript": "5.9.3",
    "typescript-eslint": "8.44.1",
    "vitest": "3.2.4"
  }
}
