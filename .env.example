# ─── Ayantaraz Production Environment ─────────────────────────────
# Copy to .env and fill in values. Run 'bash setup.sh' for auto-generation.
#
# WARNING: Do not commit .env to version control.

# ── Build Identity (immutable source revision) ──────────────────────
BUILD_ID=

# ── Public App URL (no trailing slash) ──────────────────────────────
NEXT_PUBLIC_APP_URL=https://example.com

# ── PostgreSQL ──────────────────────────────────────────────────────
DATABASE_URL=

# ── Redis ───────────────────────────────────────────────────────────
REDIS_URL=

# ── HMAC Secrets (min 32 chars, auto-generated by setup.sh) ────────
OTP_HMAC_SECRET=
SESSION_HMAC_SECRET=

# ── SMS Provider (optional — OTP returns 503 without these) ────────
# The sender POSTs { to, templateId, parameters: { code } } with a Bearer API key.
SMS_PROVIDER_URL=
SMS_API_KEY=
SMS_TEMPLATE_ID=

# ── Media Storage (optional) ───────────────────────────────────────
MEDIA_BASE_URL=
