# Build-only source revision identifier. Supply with the build environment or
# Docker's --build-arg BUILD_ID=...; do not use a mutable release label.
BUILD_ID=
# Public, canonical origin; do not add a trailing slash.
NEXT_PUBLIC_APP_URL=https://example.com
# Server-only values. Supply real values per environment; never commit them.
DATABASE_URL=
REDIS_URL=
OTP_HMAC_SECRET=
SESSION_HMAC_SECRET=
# Name and template identifier from the owner-approved SMS provider contract.
SMS_PROVIDER=
SMS_TEMPLATE_ID=
